# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Required in production (docker-compose sets it for you). Without it, dev boots an embedded MongoDB.
MONGODB_URI=
# Optional: enables the Redis cache and cross-instance Socket.IO. Falls back to in-memory.
REDIS_URL=

# Required in production, at least 16 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: without a key the AI features use offline heuristics.
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=https://api.anthropic.com

# File storage: local disk by default. Set S3_BUCKET (or STORAGE_DRIVER=s3) to store uploads in S3 or any
# S3-compatible service instead, so several instances can share files.
STORAGE_DIR=uploads
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=us-east-1
# Only for non-AWS services (Cloudflare R2, MinIO, ...); also set S3_FORCE_PATH_STYLE=true for most of them.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave the keys empty on AWS to use the default credential chain (IAM role, env vars, shared config).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional key prefix, to share one bucket between environments.
S3_PREFIX=
MAX_UPLOAD_MB=15

# Comma-separated emails allowed to use /api/admin/stats
ADMIN_EMAILS=

# Outgoing email: address confirmation, password reset and invitations. Any SMTP provider works (SES, SendGrid, Postmark,
# Mailgun, Resend, Gmail app password, or Mailpit for development). Without it emails are only written to the server log,
# so password reset cannot work. Percent-encode special characters in the password.
SMTP_URL=
MAIL_FROM=M-Space <no-reply@example.com>
# auto = insist on confirmed addresses exactly when SMTP_URL is set. true / false force it.
REQUIRE_EMAIL_VERIFICATION=auto

# Meeting recordings: speech-to-text through any OpenAI-compatible /audio/transcriptions server (OpenAI, Groq, or your own
# faster-whisper-server / LocalAI). Set the key and/or a base URL to turn on "Upload recording"; leave both empty to keep
# meetings paste-only. Keep MAX_AUDIO_MB at or below your provider's limit (OpenAI: 25).
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_CREDITS=5
MAX_AUDIO_MB=25

# Social sign-in ("Continue with Google/GitHub"). A provider is enabled when both its id and secret are set. Register
# <your app's public URL>/api/auth/oauth/<google|github>/callback as the redirect/callback URL with the provider.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Only if the public origin differs from the first CLIENT_URL (e.g. the API sits behind a different hostname).
OAUTH_REDIRECT_BASE=

# Billing. With the STRIPE_* values empty, plan changes are simulated (instant and free) - fine for development and
# demos, and refused in production unless ALLOW_SIMULATED_BILLING=true. To take real payments create two recurring
# monthly Prices in Stripe (Pro and Business), then fill these in and add the webhook (see the README).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
ALLOW_SIMULATED_BILLING=false
