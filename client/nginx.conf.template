server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 30m; # must stay above MAX_AUDIO_MB (recordings) and MAX_UPLOAD_MB

  # Same-origin API and websocket proxy so the refresh-token cookie stays first-party.
  # BACKEND_HOST/BACKEND_PORT are substituted at container start (nginx's official
  # envsubst-on-templates entrypoint). Defaults below (set in the Dockerfile) match
  # docker-compose's service name, so local/CI usage is unchanged; on Render they're
  # overridden with the backend service's private-network host/port.
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback for React Router.
  location / {
    try_files $uri /index.html;
  }
}
